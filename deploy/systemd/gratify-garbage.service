[Unit]
Description=Gratify Garbage Detection (Arduino UART + ML)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@GRATIFY_USER@
Group=@GRATIFY_USER@
WorkingDirectory=@GRATIFY_HOME@
ExecStartPre=@GRATIFY_HOME@/deploy/wait-for-boot.sh garbage 180 90
ExecStart=@CONDA_PYTHON@ -m GarbageDetection.main
Restart=always
RestartSec=15
TimeoutStartSec=300
SupplementaryGroups=dialout video

[Install]
WantedBy=multi-user.target
