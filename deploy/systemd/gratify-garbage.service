[Unit]
Description=Gratify Garbage Detection (Arduino UART + ML)
After=network-online.target gratify-update.service
Wants=network-online.target gratify-update.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@GRATIFY_USER@
Group=@GRATIFY_USER@
WorkingDirectory=@GRATIFY_HOME@
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=@GRATIFY_HOME@/deploy/wait-for-boot.sh garbage 60 15
ExecStart=@CONDA_PYTHON@ -m GarbageDetection.main
Restart=always
RestartSec=10
TimeoutStartSec=120
SupplementaryGroups=dialout video

[Install]
WantedBy=multi-user.target
