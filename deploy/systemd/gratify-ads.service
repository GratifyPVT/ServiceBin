[Unit]
Description=Gratify Ads Management (video player + API sync)
After=network-online.target graphical.target gratify-update.service
Wants=network-online.target graphical.target gratify-update.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@GRATIFY_USER@
Group=@GRATIFY_USER@
WorkingDirectory=@GRATIFY_HOME@
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/@GRATIFY_USER@/.Xauthority
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=@GRATIFY_HOME@/deploy/wait-for-boot.sh ads 60 60
ExecStart=@CONDA_PYTHON@ -m AdsManagement.service
Restart=always
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=graphical.target
